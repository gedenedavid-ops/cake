# ──────────────────────────────────────────────────────────
# BinlinPad — Variables d'environnement
# Copie ce fichier en .env.local et remplis tes clés
# Ne JAMAIS commiter .env.local — il est dans .gitignore
# ──────────────────────────────────────────────────────────

# ── MongoDB Atlas ──────────────────────────────────────────
# Crée un cluster gratuit sur https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/binlinpad?appName=Cluster0

# ── NextAuth.js ────────────────────────────────────────────
# Génère une clé secrète avec : openssl rand -base64 32
NEXTAUTH_SECRET=<openssl rand -base64 32>
# URL de l'app (http://localhost:3000 en dev, https://ton-domaine.com en prod)
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ───────────────────────────────────────────
# 1. Va sur https://console.cloud.google.com
# 2. Crée un projet → APIs & Services → Credentials → OAuth 2.0 Client ID
# 3. Authorized redirect URI : http://localhost:3000/api/auth/callback/google
#    (en prod : https://ton-domaine.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=<xxxx>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<GOCSPX-xxxx>

# ── DeepSeek (Tuteur IA) ───────────────────────────────────
# Clé disponible sur : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-<xxxx>

# ── Voyage AI (Embeddings) ─────────────────────────────────
# Clé disponible sur : https://dash.voyageai.com
VOYAGE_API_KEY=pa-<xxxx>

# ── Qdrant — collection binlinpad_notes (ton compte) ───────
# Cluster qui héberge les notes perso + historique chat
# Créer la collection : dim 1024, Cosine, Multitenancy, tenant=userId
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=<ta-cle-qdrant>
QDRANT_COLLECTION=binlinpad_notes

# ── Qdrant — collection cours_ivoiriens (compte séparé) ────
# Cluster qui héberge le curriculum ivoirien officiel (100 448 points)
# Si les deux collections sont sur le même compte, tu peux laisser vide
# (le code fallback sur QDRANT_URL / QDRANT_API_KEY)
QDRANT_CURRICULUM_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_CURRICULUM_API_KEY=<ta-cle-qdrant-curriculum>
QDRANT_CURRICULUM_COLLECTION=cours_ivoiriens

# ── Vercel Cron — purge historique chat ────────────────────
# Protège la route /api/cron/purge-history contre les appels non autorisés
# Génère avec : openssl rand -base64 32
# À configurer aussi dans le dashboard Vercel → Environment Variables
CRON_SECRET=<openssl rand -base64 32>
